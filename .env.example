# CodeSpace 3D - environment template.
# Copy to .env.local and fill in your own values. Never commit real credentials:
# everything prefixed VITE_ is inlined into the client bundle and is public.

# --- Client-safe (public, shipped in the browser bundle) ---
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Server-only (serverless routes; never prefix these with VITE_) ---
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
VERCEL_TOKEN=your-vercel-access-token
VERCEL_ORG_ID=your-vercel-org-id
VERCEL_PROJECT_ID=your-vercel-project-id
